<Window x:Class="HearEqualOrNah.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HearEqualOrNah.UI.Converters"
        Title="hearequalornah"
        Width="1040"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvas}"
        FontFamily="{StaticResource FontPrimary}"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DoubleToPercentConverter x:Key="Percent"/>
        <converters:DoubleToDbConverter x:Key="Db"/>
        <converters:TestStateToTextConverter x:Key="StateText"/>
        <converters:TestStateToVisibilityConverter x:Key="StateVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:ClassificationToBackgroundConverter x:Key="ClassVisBg"/>
        <converters:ClassificationToForegroundConverter x:Key="ClassVisFg"/>
        <converters:UtcToLocalConverter x:Key="LocalTime"/>
        <converters:UnsupportedBalanceToVisibilityConverter x:Key="UnsupportedToVis"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource TextMono}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="LineHeight" Value="34"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        </Style>

        <Style x:Key="MeterBar" TargetType="Border">
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="32,28,32,40">

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="hearequalornah" FontFamily="{StaticResource FontEditorial}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="HEADPHONE CHANNEL TEST" Style="{StaticResource SectionLabel}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Positioning warning -->
            <Border Background="{StaticResource BrushAccentYellowBg}" CornerRadius="8" Padding="16,12" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="MEASUREMENT ACCURACY" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushAccentYellowText}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"
                               Text="The accuracy of this test depends heavily on keeping the earphone and microphone in the same physical position for both measurements. Moving the earphone even slightly can change the measured level."/>
                </StackPanel>
            </Border>

            <!-- Devices -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="AUDIO DEVICES" Style="{StaticResource SectionLabel}"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Microphone" Style="{StaticResource TextSecondary}"/>
                                <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" Padding="6,2" FontSize="11" Content="Refresh" Command="{Binding RefreshDevicesCommand}"/>
                            </Grid>
                            <ComboBox Style="{StaticResource ComboBoxMinimal}" Margin="0,6,0,0"
                                      ItemsSource="{Binding Microphones}"
                                      SelectedItem="{Binding SelectedMicrophone}"
                                      ItemTemplate="{StaticResource AudioDeviceItemTemplate}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Output device" Style="{StaticResource TextSecondary}"/>
                            <ComboBox Style="{StaticResource ComboBoxMinimal}" Margin="0,6,0,0"
                                      ItemsSource="{Binding OutputDevices}"
                                      SelectedItem="{Binding SelectedOutputDevice}"
                                      ItemTemplate="{StaticResource AudioDeviceItemTemplate}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Mic sensitivity monitor -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding CurrentState, Converter={StaticResource StateVis}, ConverterParameter='Idle|Completed|Error'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MICROPHONE SENSITIVITY (LIVE)" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding MicMonitorText}" Style="{StaticResource TextMono}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource MeterBar}" Margin="0,8,0,0">
                            <Border Width="{Binding MicMonitorWidth}" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource BrushAccentBlueText}"/>
                        </Border>
                        <TextBlock Text="Switch microphones and speak or tap near each one. Pick the microphone with the strongest response above — it will give the most accurate measurement." Style="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Error banner -->
                    <Border Background="{StaticResource BrushErrorBg}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource BrushErrorText}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Test instructions -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="TEST INSTRUCTIONS" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding CurrentChannelInstruction}" Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource BrushTextPrimary}"/>

                    <!-- Live meter -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding CurrentState, Converter={StaticResource StateVis}, ConverterParameter='TestingLeft|TestingRight'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MICROPHONE LEVEL" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding LiveLevelDb, Converter={StaticResource Db}}" Style="{StaticResource TextMono}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource MeterBar}" Margin="0,8,0,0">
                            <Border Width="{Binding LiveMeterWidth}" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource BrushTextPrimary}"/>
                        </Border>
                        <TextBlock Text="Keep the earphone still." Style="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ProgressBar Style="{StaticResource ProgressBarMinimal}" Minimum="0" Maximum="1" Value="{Binding TestProgress}"
                                 Margin="0,14,0,0" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonPrimary}" Content="START TEST"
                                Command="{Binding StartTestCommand}"
                                Visibility="{Binding CurrentState, Converter={StaticResource StateVis}, ConverterParameter='Idle|Completed|Error'}"/>
                        <Button Style="{StaticResource ButtonPrimary}" Content="MEASURE LEFT"
                                Command="{Binding MeasureLeftCommand}"
                                Visibility="{Binding CurrentState, Converter={StaticResource StateVis}, ConverterParameter='ReadyForLeft'}"/>
                        <Button Style="{StaticResource ButtonPrimary}" Content="MEASURE RIGHT"
                                Command="{Binding MeasureRightCommand}"
                                Visibility="{Binding CurrentState, Converter={StaticResource StateVis}, ConverterParameter='ReadyForRight'}"/>
                        <Button Style="{StaticResource ButtonSecondary}" Content="CANCEL"
                                Command="{Binding StopTestCommand}"
                                Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Measurements -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LEFT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Margin="0,8,0,0" Text="{Binding LeftLevelDb, Converter={StaticResource Db}}"/>
                        <TextBlock Text="{Binding LeftQuality, Converter={StaticResource QualityToText}}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="RIGHT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Margin="0,8,0,0" Text="{Binding RightLevelDb, Converter={StaticResource Db}}"/>
                        <TextBlock Text="{Binding RightQuality, Converter={StaticResource QualityToText}}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DIFFERENCE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Margin="0,8,0,0" Text="{Binding DifferenceDisplay}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Result -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding ShowResultsSection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="PHYSICAL TEST RESULT" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{Binding Classification, Converter={StaticResource ClassVisBg}}" CornerRadius="6" Padding="12,8" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Classification}" FontSize="12" FontWeight="Medium" Foreground="{Binding Classification, Converter={StaticResource ClassVisFg}}"/>
                    </Border>
                    <TextBlock Text="{Binding Description}" Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                               Text="This result describes the acoustic channel balance of the measured output. It is not a hearing test and does not describe your hearing."/>
                </StackPanel>
            </Border>

            <!-- Possible causes -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding ShowCausesSection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="POSSIBLE CAUSES" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl ItemsSource="{Binding PossibleCauses}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Windows balance -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="WINDOWS AUDIO BALANCE" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Software compensation through the Windows Left/Right channel balance. Apply it here, or set it yourself in Windows (Settings &gt; System &gt; Sound &gt; your output device), then test again. This does not change the physical balance of the headphones." Style="{StaticResource TextSecondary}" Margin="0,6,0,0"/>

                    <!-- Unsupported notice -->
                    <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource BrushWarningText}"
                               Text="{Binding CurrentWindowsBalance.UnsupportedReason}"
                               Visibility="{Binding CurrentWindowsBalance, Converter={StaticResource UnsupportedToVis}}"/>

                    <!-- Current balance -->
                    <Grid Margin="0,14,0,0" Visibility="{Binding CurrentWindowsBalance.IsSupported, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current Windows balance" Style="{StaticResource TextSecondary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Left:" Style="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentWindowsBalance.LeftVolume, Converter={StaticResource Percent}}" Style="{StaticResource TextMono}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentWindowsBalance.LeftDb, StringFormat=({0:F1} dB)}" Style="{StaticResource TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Right:" Style="{StaticResource TextSecondary}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentWindowsBalance.RightVolume, Converter={StaticResource Percent}}" Style="{StaticResource TextMono}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentWindowsBalance.RightDb, StringFormat=({0:F1} dB)}" Style="{StaticResource TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Recommended balance (the user applies it in Windows) -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding ProposedCorrection, Converter={StaticResource NullToVis}}">
                        <Separator Style="{StaticResource Separator}"/>
                        <TextBlock Text="RECOMMENDED BALANCE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding ProposedCorrection.Explanation}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Target:" Style="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TargetOffsetText}" Style="{StaticResource TextMono}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Now:" Style="{StaticResource TextSecondary}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentOffsetText}" Style="{StaticResource TextMono}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RemainingAdjustmentText}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="This is an estimate based on the microphone measurement. Windows balance only changes when you click APPLY CORRECTION or adjust it yourself; the current balance above updates live." Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource ButtonPrimary}" Content="APPLY CORRECTION" Command="{Binding ApplyCorrectionCommand}"/>
                            <Button Style="{StaticResource ButtonSecondary}" Content="UNDO LAST CORRECTION" Margin="10,0,0,0" Command="{Binding UndoCorrectionCommand}"/>
                            <Button Style="{StaticResource ButtonSecondary}" Content="RESET TO EQUAL" Margin="10,0,0,0" Command="{Binding ResetBalanceCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- History -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TEST HISTORY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ButtonGhost}" Padding="6,2" FontSize="11" Content="Clear" Command="{Binding ClearHistoryCommand}"/>
                            <Button Style="{StaticResource ButtonGhost}" Padding="6,2" FontSize="11" Content="{Binding HistoryToggleText}" Command="{Binding ToggleHistoryCommand}"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding History}" Margin="0,8,0,0"
                                  Visibility="{Binding ShowHistorySection, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BrushAccentBlueBg}" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Result.Classification}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushAccentBlueText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}">
                                                <Run Text="{Binding Result.LeftResult.DbLevel, Converter={StaticResource Db}, Mode=OneWay}"/>
                                                <Run Text="  /  "/>
                                                <Run Text="{Binding Result.RightResult.DbLevel, Converter={StaticResource Db}, Mode=OneWay}"/>
                                                <Run Text="  difference "/>
                                                <Run Text="{Binding Result.DifferenceDb, StringFormat={}{0:F1} dB, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Timestamp, Converter={StaticResource LocalTime}}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>